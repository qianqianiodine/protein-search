{
  "permissions": {
    "allow": [
      "npm run dev",
      "npm run build",
      "npm install",
      "git init",
      "git add",
      "git commit",
      "git status",
      "git log",
      "git diff",
      "mkdir",
      "rm"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/claude-memory-session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/claude-memory-stop.sh"
          }
        ]
      }
    ]
  }
}
