# ============================================
# 大模型 API 配置（必填）
# ============================================
# 直接编辑此文件，填入你的 API Key
# 支持任何 OpenAI 兼容的 API 提供商，见下方示例

# === 你的 API Key（必填，替换下面这行）===
DEEPSEEK_API_KEY=your-api-key-here

# ============================================
# 以下可选：选择你的大模型提供商
# ============================================
# 只需要取消注释你要用的那一组即可
# 不取消任何一组 = 默认用 DeepSeek

# --- 方式 1：DeepSeek（国内用户推荐）---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 方式 2：OpenAI ---
# DEEPSEEK_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_MODEL=gpt-4o

# --- 方式 3：Together AI ---
# DEEPSEEK_BASE_URL=https://api.together.xyz/v1
# DEEPSEEK_MODEL=meta-llama/Llama-3-70b-chat-hf

# --- 方式 4：本地 Ollama（免费，无需 API Key）---
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_MODEL=qwen2.5:7b
