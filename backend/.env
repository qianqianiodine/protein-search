# ============================================
# 大模型 API 配置（必填）
# ============================================
# 直接编辑此文件，填入你的 API Key
# 支持任何 OpenAI 兼容的 API 提供商

# === 你的 API Key（必填，替换下面这行）===
DEEPSEEK_API_KEY=your-api-key-here

# ============================================
# 以下可选：选择你的大模型提供商
# ============================================
# 只需要取消注释你要用的那一组即可
# 不取消任何一组 = 默认用 DeepSeek

# --- DeepSeek（国内用户推荐）---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 通义千问 Qwen（阿里云）---
#   API Key 申请: https://dashscope.console.aliyun.com/
# DEEPSEEK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_MODEL=qwen-plus

# --- Kimi（月之暗面 Moonshot）---
#   API Key 申请: https://platform.moonshot.cn/
# DEEPSEEK_BASE_URL=https://api.moonshot.cn/v1
# DEEPSEEK_MODEL=moonshot-v1-8k

# --- GLM（智谱 AI）---
#   API Key 申请: https://open.bigmodel.cn/
# DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DEEPSEEK_MODEL=glm-4

# --- 豆包（字节跳动火山方舟）---
#   API Key 申请: https://console.volcengine.com/ark/
# DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_MODEL=doubao-pro-32k

# --- OpenAI ---
#   API Key 申请: https://platform.openai.com/
# DEEPSEEK_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_MODEL=gpt-4o

# --- Together AI ---
#   API Key 申请: https://api.together.ai/
# DEEPSEEK_BASE_URL=https://api.together.xyz/v1
# DEEPSEEK_MODEL=meta-llama/Llama-3-70b-chat-hf

# --- 本地 Ollama（免费，无需 API Key）---
#   https://ollama.com/
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_MODEL=qwen2.5:7b
